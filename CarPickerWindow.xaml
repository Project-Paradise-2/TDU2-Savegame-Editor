<Window x:Class="TDU2SaveEditor.CarPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fahrzeug auswählen" Height="620" Width="760"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Header}" Text="Fahrzeug auswählen"/>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Suche:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="TxtSearch" Width="320" TextChanged="Search_Changed"/>
            <TextBlock x:Name="TxtCount" VerticalAlignment="Center" Margin="10,0,0,0"
                       Foreground="{StaticResource FgDim}"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Übernehmen" Style="{StaticResource AccentButton}" Click="Ok_Click" IsDefault="True"/>
            <Button Content="Abbrechen" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
        <DataGrid x:Name="DgCars" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Modell" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="Marke" Binding="{Binding Brand}" Width="120"/>
                <DataGridTextColumn Header="PS" Binding="{Binding PowerBhp}" Width="60"/>
                <DataGridTextColumn Header="Vmax (km/h)" Binding="{Binding TopSpeed}" Width="90"/>
                <DataGridTextColumn Header="Preis" Binding="{Binding Price}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
